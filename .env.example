# ---- 基础 ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clubos?schema=public"
PORT=3000
JWT_SECRET="change-me"
# 管理端登录口令（demo 用，生产应改为 OAuth / 密码哈希）
ADMIN_CODE="clubos-admin"
# 密钥保管加密密钥（加密存储 LLM Key），必须正好 32 字节
KEY_VAULT_SECRET="change-me-32bytes-key-vault-sec"
# 会员版「AI 全包」平台 LLM Key（DeepSeek 等）；留空则会员版 AI 代理不可用
PLATFORM_LLM_KEY=""

# ---- 视觉模型（照片识别，v151）----
# 留空时回退 PLATFORM_LLM_KEY（需该 Key 支持视觉）；填了才启用 /ai-vision
PLATFORM_VISION_KEY=""
# 视觉模型名：gpt-4o-mini / qwen-vl-max / glm-4v-flash / gemini-2.0-flash ...
PLATFORM_VISION_MODEL="gpt-4o-mini"
# OpenAI 兼容 Base URL
PLATFORM_VISION_BASE="https://api.openai.com/v1"

# ---- 业务参数 ----
# 免费版默认抽成 5%；会员版 plan=member 时按 merchants.commission_rate 覆盖为 0
DEFAULT_COMMISSION_RATE=0.05
# 未支付订单自动关闭时间（分钟）
ORDER_EXPIRE_MINUTES=30
# CORS 允许的前端来源（逗号分隔）。默认 * = 反射请求方 Origin。
# 前端部署在 GitHub Pages（如 https://kumaoxxx.github.io）时必须放行，否则浏览器
# 预检 OPTIONS 无 Access-Control-Allow-Origin → fetch 直接抛错（服务端 curl 却是通的）。
CORS_ORIGINS="*"

# ---- 微信支付服务商（待接入，留空即走桩实现）----
WECHAT_MCH_ID=""
WECHAT_APPID=""
WECHAT_API_V3_KEY=""
WECHAT_SERIAL_NO=""
WECHAT_PRIVATE_KEY_PATH="./certs/apiclient_key.pem"
WECHAT_PLATFORM_CERT_PATH="./certs/wechatpay_platform_cert.pem"
WECHAT_NOTIFY_URL="https://your-domain.com/api/pay/notify"
